# ---------- Telegram userbot ----------
# api_id / api_hash: https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Session string from `tgmcp-login` (or `docker compose run --rm tgmcp tgmcp-login`).
# Gives FULL access to the account: keep it secret, never commit it.
TG_SESSION=

# Chats Claude may read. Comma/semicolon/newline separated. The account must be a member of private chats.
# Supported: @username, t.me/username, numeric id (-1001234567890), t.me/c/1234567890, invite link t.me/+hash
TG_CHATS=@chat_one, @chat_two, -1001234567890

# Optional: socks5://user:pass@host:port or http://host:port
TG_PROXY=
# Max characters of each message returned to Claude (0 = no limit)
TG_MAX_MESSAGE_CHARS=1500

# ---------- MCP server ----------
# stdio (Claude Code / Claude Desktop launch it locally) or http (remote server / claude.ai custom connector)
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Required for http. Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Clients send it as "Authorization: Bearer <token>" or use the URL https://<domain>/<token>/mcp
MCP_AUTH_TOKEN=
# Public domain for the built-in Caddy HTTPS proxy (docker compose --profile https up -d)
DOMAIN=
# Docker only: host port the server is published on (bound to 127.0.0.1). Point your own reverse proxy
# or tunnel (e.g. `tailscale funnel --bg <port>`) at it. MCP_PORT above is ignored in Docker.
TGMCP_LOCAL_PORT=8000

# ---------- Load management (defaults are fine for most setups) ----------
# Tool calls executed at once; extra calls wait in a FIFO queue
MCP_MAX_CONCURRENT_CALLS=8
# Seconds a call may wait in the queue before the client gets "server busy, retry"
MCP_QUEUE_TIMEOUT=120
# How many calls may wait in the queue at once
MCP_MAX_QUEUE=200
# Simultaneous HTTP connections; above this the server answers 503 instead of overloading
MCP_MAX_CONNECTIONS=256
# Simultaneous requests to Telegram (keep low to avoid FloodWait)
TG_PARALLEL_REQUESTS=4
# Seconds identical Telegram reads are reused across clients (0 = off)
TG_CACHE_TTL=120

LOG_LEVEL=INFO
